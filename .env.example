# Copy this file to .env and fill in your own values.
# Never commit .env or share these values with anyone.

# Token from @BotFather, looks like 123456789:AA...
TELEGRAM_BOT_TOKEN=

# Supabase project URL, looks like https://abcdefghijkl.supabase.co
SUPABASE_URL=

# Supabase server-side key (the "secret" key, or the legacy "service_role" key).
# This key bypasses Row Level Security, so keep it on the server only.
SUPABASE_SERVICE_ROLE_KEY=

# Optional: debug | info | warn | error (default: info)
LOG_LEVEL=info
